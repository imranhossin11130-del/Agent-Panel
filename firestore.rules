rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Hardened Entity Validation
    function isValidAgent(data) {
      return data.keys().hasAll(['uid', 'agentId', 'name', 'phone', 'walletBalance', 'commissionBalance', 'isVerified'])
        && (data.keys().size() >= 7 && data.keys().size() <= 18)
        && data.uid is string && data.uid.size() <= 128
        && data.agentId is string && data.agentId.size() <= 32
        && data.name is string && data.name.size() <= 128
        && data.phone is string && data.phone.size() <= 32
        && data.walletBalance is number && data.walletBalance >= 0
        && data.commissionBalance is number && data.commissionBalance >= 0
        && data.isVerified is bool
        && (!data.keys().hasAny(['hasTakenSuperBalance']) || data.hasTakenSuperBalance is bool)
        && (!data.keys().hasAny(['superBalanceTotal']) || data.superBalanceTotal is number)
        && (!data.keys().hasAny(['referBalance']) || data.referBalance is number)
        && (!data.keys().hasAny(['referredBy']) || data.referredBy == null || data.referredBy is string)
        && (!data.keys().hasAny(['referStatus']) || data.referStatus is string)
        && (!data.keys().hasAny(['referWaitingUntil']) || data.referWaitingUntil == null || data.referWaitingUntil is number)
        && (!data.keys().hasAny(['referApprovalLink']) || data.referApprovalLink == null || data.referApprovalLink is string)
        && (!data.keys().hasAny(['referCount']) || data.referCount is number);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDepositRequest(data) {
      return data.keys().hasAll(['id', 'agentUid', 'agentName', 'agentPhone', 'type', 'senderPhone', 'amount', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.agentUid is string && data.agentUid.size() <= 128
        && data.agentName is string && data.agentName.size() <= 128
        && data.agentPhone is string && data.agentPhone.size() <= 32
        && data.type is string && (data.type == 'own' || data.type == 'super')
        && data.senderPhone is string && data.senderPhone.size() <= 32
        && data.amount is number && data.amount > 0
        && data.status is string && (data.status == 'pending' || data.status == 'success' || data.status == 'failed')
        && data.createdAt is string;
    }

    function isValidCommissionWithdrawal(data) {
      return data.keys().hasAll(['id', 'agentUid', 'agentName', 'agentPhone', 'paymentMethod', 'phoneNumber', 'amount', 'status', 'createdAt'])
        && (data.keys().size() >= 9 && data.keys().size() <= 11)
        && data.id is string && data.id.size() <= 128
        && data.agentUid is string && data.agentUid.size() <= 128
        && data.agentName is string && data.agentName.size() <= 128
        && data.agentPhone is string && data.agentPhone.size() <= 32
        && data.paymentMethod is string && data.paymentMethod.size() <= 64
        && data.phoneNumber is string && data.phoneNumber.size() <= 32
        && data.amount is number && data.amount > 0
        && data.status is string && (data.status == 'pending' || data.status == 'success' || data.status == 'failed')
        && data.createdAt is string;
    }

    // Match rules for agent profiles
    match /agents/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      // Require owner UID and schema validation on creation
      allow create: if isOwner(uid) && isValidAgent(incoming()) && incoming().uid == request.auth.uid;
      
      // Segmented updates using affectedKeys check
      allow update: if isOwner(uid) || (isSignedIn() && request.auth.token.email == 'bdwalletagent@gmail.com') || (
        // Action 1: Profile metadata (Name/Avatar/Referral Details) update
        (incoming().diff(existing()).affectedKeys().hasAny(['name', 'avatarUrl', 'referredBy', 'referStatus', 'referWaitingUntil', 'referApprovalLink', 'referCount']) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'referredBy', 'referStatus', 'referWaitingUntil', 'referApprovalLink', 'referCount', 'uid', 'agentId', 'phone', 'walletBalance', 'commissionBalance', 'isVerified', 'referBalance']) &&
         (!incoming().keys().hasAny(['name']) || (incoming().name is string && incoming().name.size() <= 128))) ||
         
        // Action 2: Operational balance modifications (transacting/refilling/referral bonuses)
        (incoming().diff(existing()).affectedKeys().hasAny(['walletBalance', 'commissionBalance', 'referBalance', 'referCount']) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['walletBalance', 'commissionBalance', 'referBalance', 'referCount', 'uid', 'agentId', 'name', 'phone', 'avatarUrl', 'isVerified', 'referredBy', 'referStatus', 'referWaitingUntil', 'referApprovalLink']) &&
         incoming().walletBalance is number && incoming().walletBalance >= 0 &&
         incoming().commissionBalance is number && incoming().commissionBalance >= 0 &&
         (!incoming().keys().hasAny(['referBalance']) || (incoming().referBalance is number && incoming().referBalance >= 0)) &&
         (!incoming().keys().hasAny(['referCount']) || incoming().referCount is number))
      );

      allow delete: if false;

      // Rules for agent transaction history
      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || (isSignedIn() && request.auth.token.email == 'bdwalletagent@gmail.com');
        allow create, update: if isSignedIn() && (request.auth.token.email == 'bdwalletagent@gmail.com' || isOwner(uid));
        allow delete: if false;
      }
    }

    // Match rules for agent deposit requests
    match /deposit_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.agentUid == request.auth.uid || request.auth.token.email == 'bdwalletagent@gmail.com');
      allow list: if isSignedIn() && (resource.data.agentUid == request.auth.uid || request.auth.token.email == 'bdwalletagent@gmail.com');
      allow create: if isSignedIn() && isValidId(requestId) && isValidDepositRequest(incoming()) && incoming().agentUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.token.email == 'bdwalletagent@gmail.com' ||
        (resource.data.agentUid == request.auth.uid && 
         resource.data.type == 'super' && 
         incoming().status == 'success' && 
         existing().status == 'pending' &&
         isValidDepositRequest(incoming()))
      );
      allow delete: if false;
    }

    // Match rules for agent referral requests
    match /referral_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Match rules for commission withdrawals
    match /commission_withdrawals/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.agentUid == request.auth.uid || request.auth.token.email == 'bdwalletagent@gmail.com');
      allow list: if isSignedIn() && (resource.data.agentUid == request.auth.uid || request.auth.token.email == 'bdwalletagent@gmail.com');
      allow create: if isSignedIn() && isValidId(requestId) && isValidCommissionWithdrawal(incoming()) && incoming().agentUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.token.email == 'bdwalletagent@gmail.com'
      );
      allow delete: if false;
    }
  }
}
